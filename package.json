{
  "name": "xray-mini-app-template-react",
  "version": "1.0.2",
  "author": "XRAY/Network <hello@xray.app>",
  "description": "XRAY Mini App Template React Version",
  "license": "MIT",
  "homepage": "https://xray.app",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xray-network/xray-mini-app-template-react.git"
  },
  "bugs": {
    "url": "https://github.com/xray-network/xray-mini-app-template-react/issues"
  },
  "keywords": [
    "Cardano",
    "XRAY",
    "Mini App",
    "JavaScript",
    "SDK"
  ],
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "react-router dev --host --port 7220",
    "build": "react-router build",
    "deploy": "npm run build && wrangler pages deploy",
    "preview": "npm run build && wrangler pages dev build/client",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json,md,mdx,css,scss}\""
  },
  "imports": {
    "#tailwind.css": "app/styles/tailwind.css"
  },
  "dependencies": {
    "@ant-design/happy-work-theme": "^2.0.0",
    "@heroicons/react": "^2.2.0",
    "@react-router/node": "7.8.2",
    "@xray-network/xray-js": "file:../xray-js/packages/runtime",
    "antd": "^6.6.0",
    "classnames": "^2.5.1",
    "isbot": "^5",
    "lodash": "^4.17.21",
    "nprogress": "^0.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-jazzicon": "^1.0.4",
    "react-router": "^7.8.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.8.2",
    "@tailwindcss/vite": "^4.1.17",
    "@types/lodash": "^4.17.18",
    "@types/node": "^20",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.1.4",
    "vite-plugin-svgr": "^4.5.0",
    "vite-plugin-wasm": "^3.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.45.0"
  }
}
